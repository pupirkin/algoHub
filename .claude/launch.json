{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "algo-api-preview",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "algo_api.preview:create_preview_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "portal-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "ALGOHUB_FLAGS=preview:P15 pnpm --filter @algohub/portal-web start"],
      "port": 3000
    }
  ]
}
