{
  "extends": "@algohub/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "app",
    "src",
    "e2e",
    "e2e-products",
    "next.config.ts",
    "middleware.ts",
    "playwright.config.ts",
    "playwright.products.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
