# Copy to .env (`just setup` does it). This file must never contain real secrets.
# Values below are LOCAL-DEVELOPMENT placeholders only.

# --- Postgres (docker compose) ---
POSTGRES_USER=algohub
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=algohub
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# --- algo-api (pydantic-settings, prefix ALGOHUB_) ---
ALGOHUB_ENV=dev
ALGOHUB_LOG_LEVEL=INFO
ALGOHUB_LOG_JSON=true
ALGOHUB_DATABASE_URL=postgresql+psycopg://algohub:local-dev-only-change-me@127.0.0.1:5432/algohub
ALGOHUB_CORS_ORIGINS=http://localhost:3000
# Request body limit in bytes (413 above it); default 16384.
ALGOHUB_MAX_BODY_BYTES=16384
# Integration tests (`just test-int`) use the tmpfs postgres-test service.
ALGOHUB_TEST_DATABASE_URL=postgresql+psycopg://algohub:local-dev-only-change-me@127.0.0.1:5433/algohub_test

# --- portal-web (only NEXT_PUBLIC_* reaches the browser bundle) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-only feature flags. `preview:P15` serves P15's real UI below MVP_READY (with a visible notice).
ALGOHUB_FLAGS=
